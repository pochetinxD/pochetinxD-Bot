# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas tu .env real a GitHub.

# Tu número con código de país, sin + ni espacios. Ej: 5215512345678
OWNER_NUMBER=5210000000000

# Entrar con código (es el default): el bot te da un código
# de 8 caracteres para meterlo en WhatsApp > Dispositivos vinculados
# > Vincular con número de teléfono. Si PAIRING_PHONE está vacío,
# usa OWNER_NUMBER. La sesión queda guardada igual que con el QR.
# Para volver al QR, pon USE_PAIRING_CODE=false.
USE_PAIRING_CODE=true
PAIRING_PHONE=

# Prefijo de comandos
PREFIX=!

# Números que nunca pasan por el antispam (separados por coma)
WHITELIST=

# Números bloqueados (separados por coma)
BLOCKLIST=

# Límites antispam (ajústalos a tu gusto, ver README)
MAX_MSG_PER_MIN=8
MAX_MSG_PER_10MIN=30
MUTE_SECONDS=60
MAX_FORWARDED_PER_HOUR=5
MAX_LINKS_PER_MSG=2
MAX_LINKS_PER_10MIN=5

# Grupos
GROUP_ONLY_ADMINS=false
IGNORE_GROUPS=false

# Economía / gacha / niveles (todo local, sin APIs)
START_COINS=100
DAILY_MIN=50
DAILY_MAX=150
WORK_MIN=10
WORK_MAX=40
BET_MIN=10
BET_MAX=500
GIVE_MAX=1000
WARN_LIMIT=3

# Delays humanos antes de responder (ms)
MIN_REPLY_DELAY_MS=800
MAX_REPLY_DELAY_MS=2500
SHOW_TYPING=true

# Reconexión (backoff exponencial: base, tope e intentos máximos)
RECONNECT_BASE_MS=5000
RECONNECT_MAX_MS=300000
RECONNECT_MAX_ATTEMPTS=10

# Caché de metadatos de grupo y memoria del antispam
GROUP_META_TTL_MS=45000
ANTISPAM_MAX_USERS=500
ANTISPAM_USER_TTL_MS=1800000
ANTISPAM_WARN_DECAY_MS=3600000
