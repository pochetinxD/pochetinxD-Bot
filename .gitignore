# Sesión de WhatsApp (contiene tus credenciales, NUNCA se sube)
auth_info/
auth_info/**

# Entorno: el .env real nunca se sube; el ejemplo sí
.env
.env.local
.env.*
!.env.example

# Datos reales del bot (economía, niveles, avisos, AFK, gacha).
# NO se suben. Solo el catálogo de gacha y los ejemplos:
data/*.json
!data/waifus.json
!data/*.example.json
# Temporales y respaldos de archivos corruptos del store
data/*.tmp
data/*.corrupt-*
*.tmp

# Dependencias
node_modules/

# Logs y SO
*.log
.DS_Store

# Cobertura de pruebas
coverage/
